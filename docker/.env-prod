COMPOSE_PROJECT_NAME=superset

DATABASE_PORT=5432
DATABASE_DIALECT=postgresql

# PYTHONPATH includes pythonpath_dev for superset_config.py and custom security manager
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev

# Default Redis values — overridden by .env (from Secrets Manager) in production
REDIS_HOST=redis
REDIS_PORT=6379

SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=
