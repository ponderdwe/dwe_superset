# Copy to .env, then start:
#   docker-compose up -d
#
# Local dev uses docker-compose.override.yml which adds local Redis + PostgreSQL,
# so you only need to set SUPERSET_SECRET_KEY and optionally SUPERSET_ADMIN_PASSWORD.

# Flask secret key — generate with: openssl rand -hex 32
SUPERSET_SECRET_KEY=dev-secret-replace-in-prod

# Superset admin password (used by docker-init.sh on first run)
SUPERSET_ADMIN_PASSWORD=admin

# ── Overridden automatically by docker-compose.override.yml in local dev ──────
# In production these come from AWS Secrets Manager.

# ── Database (existing PostgreSQL cluster) ────────────────────────────────────
# DB_HOST=myserver.postgres.database.azure.com
# DB_PASS=mypassword
# DB_USER=superset          # optional, defaults to 'superset'
# DB_PORT=5432              # optional
# Pulumi will create the database named 'superset' (or 'superset_dev' for dev)
# and inject SQLALCHEMY_DATABASE_URI automatically.
# For local dev, SQLALCHEMY_DATABASE_URI is set by docker-compose.override.yml

# Redis connection (ElastiCache in prod, local container in dev)
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── Optional: OAuth / SSO ─────────────────────────────────────────────────────
# Set all three to enable OneLogin SSO. Leave empty to use local auth.
# client_id=
# client_secret=
# ol_base_url=myorg.onelogin.com

# ── Production infrastructure (not needed locally) ────────────────────────────
# These are injected from AWS Secrets Manager in the EC2 user-data script.
# VPC_ID=
# ALB_SUBNET_IDS=["subnet-aaa","subnet-bbb"]
# KEY_NAME=
# ROUTE53_ZONE_ID=
# DNS_NAME=superset.myorg.com
# ACM_CERTIFICATE_ARN=
# git_deploy_token=
